# ==========================================
# VitaMind Frontend — Git Ignore Configuration
# ==========================================

# 1. Dependencies & Package Managers
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Build & Export Outputs
/.next/
/out/
/build/
/dist/

# 3. Environment & Secret Files
.env*
!.env.example
!.env.sample

# 4. Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# 5. Testing & Code Quality
/coverage/

# 6. TypeScript Cache & Generated Types
*.tsbuildinfo
next-env.d.ts

# 7. Deployment Platforms
.vercel

# 8. OS & Editor Specific Files
.DS_Store
*.pem
.idea/
.vscode/

# 9. Local AI Caches & Local Directories
/doc
.claude/
.kilo/

# Do NOT Ignore (Critical Config & Guidelines Files)
CLAUDE.md
AGENTS.md
.claudeignore