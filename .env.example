# VitaMind patient app — environment contract. Copy to `.env.local` (local) or set in Vercel (production).
# Placeholders only: never commit real secrets.

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the NestJS API, WITHOUT a trailing slash and without /api/v1.
# It must be the same URL the API itself documents: vitamind_backend/apps/api/.env.example
#   - local:       the API listens on PORT=3000 there -> http://localhost:3000
#   - production:  the Render service URL            -> https://<your-service>.onrender.com
#
# The browser calls this URL DIRECTLY, including the live connections (server-sent events):
#   GET  /api/v1/events                         one stream for the whole patient shell
#   POST /api/v1/mira/session/:id/message/stream, /api/v1/me/lumina/chat/stream, /api/v1/me/spark/chat/stream
# They never go through a Next.js rewrite or route handler (Vercel would cut the stream), so:
#   - this value is baked in at build time (NEXT_PUBLIC_*): change it, rebuild;
#   - the API's CORS_ORIGINS must list this site's origin (https://<your-app>.vercel.app, and
#     http://localhost:3001 for local development, since the API already uses port 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional, server-side only: lets the Next.js server reach the API over a private/internal URL
# (used by the same-origin /api/mira proxy). Never used by the browser or by the live streams.
# API_SERVICE_URL=

# ── Local development ────────────────────────────────────────────────────────
# `next dev` also defaults to port 3000, which the API uses locally. Run the app on 3001:
#   npm run dev -- -p 3001
# Test streaming and live updates with a production build (`npm run build && npm run start -- -p 3001`):
# the dev server buffers differently from Vercel.

# ── Other services (legacy / optional) ───────────────────────────────────────
NEXT_PUBLIC_CHATBOT_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_FR=
ELEVENLABS_VOICE_ID_DERJA=
